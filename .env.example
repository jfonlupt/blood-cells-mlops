# Copier en .env (déjà dans .gitignore) et renseigner de vraies valeurs.
# Variables lues par docker-compose.yaml pour les services minio/mlflow/bento.

# --- MLflow (serveur de tracking + registre de modèles) ---
MLFLOW_PORT=5001
MLFLOW_ARTFACT_BUCKET=mlflow-artifacts

# --- MinIO (stockage S3 des artefacts MLflow) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Service d'inférence Bento ---
JWT_SECRET_KEY=change-me
BENTO_USER=change-me
BENTO_PASSWORD=change-me
BENTO_PORT=8000

# --- Airflow (DAG retrain_on_drift : dags/retrain_on_drift.py) ---
# Secret de signature des tokens JWT internes à Airflow (Execution API) --
# DOIT être identique sur les 4 conteneurs airflow-* (webserver, scheduler,
# worker, dag-processor), sinon chacun génère le sien et les tokens émis
# par l'un ne sont jamais reconnus par un autre. Générer avec :
#   openssl rand -base64 32
AIRFLOW_JWT_SECRET=change-me
# Nom du réseau docker-compose de ce projet (`docker network ls`, en
# général <nom-du-dossier-projet>_default) : permet au conteneur
# d'entraînement lancé par DockerOperator de résoudre mlflow/minio.
RETRAIN_DOCKER_NETWORK=jul26_bds_blood_cells_default
# Chemins HÔTE (pas les chemins vus depuis les conteneurs airflow-*) à
# monter en bind dans le conteneur d'entraînement. Le défaut dans
# docker-compose.yaml (${PWD}/...) ne fonctionne que si `docker compose up`
# est lancé depuis la racine du dépôt -- surcharger ici avec des chemins
# absolus fixes sinon.
# RETRAIN_HOST_CONFIGS_DIR=/chemin/absolu/vers/le/depot/configs
# RETRAIN_HOST_DATA_DIR=/chemin/absolu/vers/le/depot/data
# RETRAIN_HOST_RESULTS_DIR=/chemin/absolu/vers/le/depot/results
